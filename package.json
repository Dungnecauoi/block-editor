{
  "name": "@duxbo/block-editor",
  "version": "1.0.0",
  "description": "Enterprise-grade block editor built on Editor.js — all tools, themes, i18n, and export included in one package",
  "type": "module",
  "main": "./dist/block-editor.cjs",
  "module": "./dist/block-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/block-editor.js",
      "require": "./dist/block-editor.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "keywords": [
    "editor",
    "block-editor",
    "editorjs",
    "wysiwyg",
    "rich-text",
    "enterprise",
    "content-editor"
  ],
  "author": "Duxbo",
  "license": "MIT",
  "dependencies": {
    "@calumk/editorjs-codeflask": "^1.0.0",
    "@calumk/editorjs-columns": "^0.3.0",
    "@editorjs/attaches": "^1.3.0",
    "@editorjs/checklist": "^1.6.0",
    "@editorjs/code": "^2.9.0",
    "@editorjs/delimiter": "^1.4.0",
    "@editorjs/editorjs": "^2.30.0",
    "@editorjs/embed": "^2.7.0",
    "@editorjs/header": "^2.8.0",
    "@editorjs/image": "^2.10.0",
    "@editorjs/inline-code": "^1.5.0",
    "@editorjs/link": "^2.6.0",
    "@editorjs/list": "^2.0.0",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/nested-list": "^1.4.0",
    "@editorjs/paragraph": "^2.11.0",
    "@editorjs/quote": "^2.7.0",
    "@editorjs/raw": "^2.5.0",
    "@editorjs/simple-image": "^1.6.0",
    "@editorjs/table": "^2.4.0",
    "@editorjs/text-variant-tune": "^1.0.0",
    "@editorjs/underline": "^1.2.0",
    "@editorjs/warning": "^1.4.0",
    "editorjs-alert": "^1.1.0",
    "editorjs-button": "^1.0.0",
    "editorjs-change-case": "^0.0.2",
    "editorjs-drag-drop": "^1.1.0",
    "editorjs-hyperlink": "^1.0.0",
    "editorjs-indent-tune": "^1.4.0",
    "editorjs-inline-image": "^1.1.0",
    "editorjs-text-alignment-blocktune": "^1.0.0",
    "editorjs-text-color-plugin": "^2.0.0",
    "editorjs-toggle-block": "^0.3.0",
    "editorjs-tooltip": "^1.0.0",
    "editorjs-undo": "^2.0.0",
    "katex": "^0.16.0",
    "mermaid": "^11.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
